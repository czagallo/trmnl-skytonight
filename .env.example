PORT=3014
BASE_URL=https://your-public-plugin-url.example
TRMNL_CLIENT_ID=your_client_id_here
TRMNL_CLIENT_SECRET=your_client_secret_here

# Optional: where user settings are stored (default: ./data/connections.json)
# DATA_FILE=

# Optional: Open-Meteo call budget (free API: < 10,000/day, 5,000/hour). Defaults: half of that.
# OPEN_METEO_DAILY_CALLS=5000
# OPEN_METEO_HOURLY_CALLS=1000

# Local preview only (npm run preview -- --live). Real TRMNL users set their location on the settings page.
# SKY_LAT=48.2082
# SKY_LON=16.3738
# SKY_PLACE=Vienna
# SKY_TZ=Europe/Vienna
